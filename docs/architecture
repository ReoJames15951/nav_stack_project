<svg width="720" height="460" viewBox="0 0 720 460" xmlns="http://www.w3.org/2000/svg" role="img">
<title>nav_stack_project architecture</title>
<desc>Data flow from Gazebo simulation through SLAM Toolbox and Nav2 to robot velocity commands</desc>

<defs>
  <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
    <path d="M2 1L8 5L2 9" fill="none" stroke="#5f5e5a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </marker>
</defs>

<style>
  text { font-family: -apple-system, Helvetica, Arial, sans-serif; }
  .title { font-size: 14px; font-weight: 600; }
  .sub { font-size: 11px; }
  .box { stroke-width: 1; rx: 8; }
</style>

<!-- Row 1: Simulation -->
<rect class="box" x="40" y="30" width="180" height="56" rx="8" fill="#E1F5EE" stroke="#0F6E56"/>
<text class="title" x="130" y="52" text-anchor="middle" fill="#085041">Gazebo + robot.urdf</text>
<text class="sub" x="130" y="70" text-anchor="middle" fill="#0F6E56">diff-drive base + LiDAR</text>

<line x1="220" y1="58" x2="270" y2="58" stroke="#5f5e5a" stroke-width="1" marker-end="url(#arrow)"/>
<text class="sub" x="245" y="48" text-anchor="middle" fill="#5f5e5a">/scan</text>

<!-- Row 1 right: SLAM -->
<rect class="box" x="270" y="30" width="180" height="56" rx="8" fill="#EEEDFE" stroke="#534AB7"/>
<text class="title" x="360" y="52" text-anchor="middle" fill="#3C3489">SLAM Toolbox</text>
<text class="sub" x="360" y="70" text-anchor="middle" fill="#534AB7">builds occupancy map</text>

<line x1="360" y1="86" x2="360" y2="130" stroke="#5f5e5a" stroke-width="1" marker-end="url(#arrow)"/>
<text class="sub" x="392" y="112" text-anchor="middle" fill="#5f5e5a">/map</text>

<!-- Row 2: Nav2 container -->
<rect x="60" y="140" width="600" height="220" rx="16" fill="#FAECE7" stroke="#993C1D" stroke-width="1"/>
<text class="title" x="90" y="165" fill="#712B13">Nav2 stack</text>

<!-- Costmaps -->
<rect class="box" x="90" y="185" width="160" height="56" rx="8" fill="#FCEBEB" stroke="#A32D2D"/>
<text class="title" x="170" y="207" text-anchor="middle" fill="#791F1F">Costmaps</text>
<text class="sub" x="170" y="225" text-anchor="middle" fill="#A32D2D">global + local</text>

<line x1="250" y1="213" x2="290" y2="213" stroke="#5f5e5a" stroke-width="1" marker-end="url(#arrow)"/>

<!-- Planner Server (custom) -->
<rect class="box" x="290" y="185" width="180" height="56" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="1.5"/>
<text class="title" x="380" y="203" text-anchor="middle" fill="#633806">planner_server</text>
<text class="sub" x="380" y="219" text-anchor="middle" fill="#854F0B">custom StraightLinePlanner</text>
<text class="sub" x="380" y="233" text-anchor="middle" fill="#854F0B">(nav2_core::GlobalPlanner)</text>

<line x1="470" y1="213" x2="510" y2="213" stroke="#5f5e5a" stroke-width="1" marker-end="url(#arrow)"/>
<text class="sub" x="490" y="203" text-anchor="middle" fill="#5f5e5a">/plan</text>

<!-- Controller Server -->
<rect class="box" x="510" y="185" width="130" height="56" rx="8" fill="#FCEBEB" stroke="#A32D2D"/>
<text class="title" x="575" y="207" text-anchor="middle" fill="#791F1F">controller_server</text>
<text class="sub" x="575" y="225" text-anchor="middle" fill="#A32D2D">DWB local planner</text>

<!-- BT Navigator below -->
<rect class="box" x="290" y="275" width="180" height="56" rx="8" fill="#FCEBEB" stroke="#A32D2D"/>
<text class="title" x="380" y="297" text-anchor="middle" fill="#791F1F">bt_navigator</text>
<text class="sub" x="380" y="315" text-anchor="middle" fill="#A32D2D">orchestrates the stack</text>

<line x1="380" y1="241" x2="380" y2="275" stroke="#5f5e5a" stroke-width="1" marker-end="url(#arrow)"/>

<!-- Output -->
<line x1="575" y1="241" x2="575" y2="300" stroke="#5f5e5a" stroke-width="1"/>
<line x1="575" y1="300" x2="360" y2="400" stroke="#5f5e5a" stroke-width="1" marker-end="url(#arrow)"/>
<text class="sub" x="500" y="330" text-anchor="middle" fill="#5f5e5a">/cmd_vel</text>

<!-- Back to robot -->
<rect class="box" x="230" y="400" width="180" height="50" rx="8" fill="#E1F5EE" stroke="#0F6E56"/>
<text class="title" x="320" y="422" text-anchor="middle" fill="#085041">Robot base</text>
<text class="sub" x="320" y="438" text-anchor="middle" fill="#0F6E56">diff_drive controller</text>

</svg>
