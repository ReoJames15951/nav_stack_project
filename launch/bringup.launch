import os
from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import IncludeLaunchDescription
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch_ros.actions import Node


def generate_launch_description():
    """
    Full portfolio-demo bringup: Gazebo + robot spawn + SLAM Toolbox + RViz.

    Usage:
      1. ros2 launch nav_stack_project bringup.launch.py     # mapping mode
      2. Drive the robot around (teleop_twist_keyboard) to build a map
      3. ros2 run nav2_map_server map_saver_cli -f src/nav_stack_project/maps/map
      4. Kill this, then run nav2.launch.py with that saved map for autonomous nav
    """
    pkg_share = get_package_share_directory('nav_stack_project')

    gazebo_launch = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            os.path.join(pkg_share, 'launch', 'gazebo.launch.py')
        )
    )

    slam_launch = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            os.path.join(pkg_share, 'launch', 'slam.launch.py')
        )
    )

    rviz_node = Node(
        package='rviz2',
        executable='rviz2',
        arguments=['-d', os.path.join(pkg_share, 'rviz', 'nav_view.rviz')],
        output='screen'
    )

    return LaunchDescription([
        gazebo_launch,
        slam_launch,
        rviz_node,
    ])
